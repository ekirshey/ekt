{
  "version": 6,
  "configurePresets": [
    {
      "name": "mac_default",
      "inherits": "mac_debug",
      "binaryDir": "${sourceDir}/out/build/release/",
      "installDir": "${sourceDir}/out/install/release/",
      "environment": {
        "VCPKG_ROOT": "/Users/ekir/sadbrains/core_tech/vcpkg"
      }
    },
    {
      "name": "nix_default",
      "inherits": "nix_debug",
      "binaryDir": "${sourceDir}/out/build/release/",
      "installDir": "${sourceDir}/out/install/release/",
      "environment": {
        "VCPKG_ROOT": "/home/ekir/vcpkg"
      }
    },
    {
      "name": "win_default",
      "inherits": "win_debug",
      "binaryDir": "${sourceDir}/out/build/release/",
      "installDir": "${sourceDir}/out/install/release/",
      "environment": {
        "VCPKG_ROOT": "E:/vcpkg"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac_build", "configurePreset": "mac_default" },
    { "name": "nix_build", "configurePreset": "nix_default" },
    { "name": "win_build", "configurePreset": "win_default", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "mac_test", "configurePreset": "mac_default", "output": { "outputOnFailure": true } },
    { "name": "nix_test", "configurePreset": "nix_default", "output": { "outputOnFailure": true } },
    { "name": "win_test", "configurePreset": "win_default", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "mac_test",
      "steps": [
        { "type": "configure", "name": "mac_default" },
        { "type": "build", "name": "mac_build" },
        { "type": "test", "name": "mac_test" }
      ]
    },
    {
      "name": "nix_test",
      "steps": [
        { "type": "configure", "name": "nix_default" },
        { "type": "build", "name": "nix_build" },
        { "type": "test", "name": "nix_test" }
      ]
    },
    {
      "name": "win_test",
      "steps": [
        { "type": "configure", "name": "win_default" },
        { "type": "build", "name": "win_build" },
        { "type": "test", "name": "win_test" }
      ]
    }
  ]
}
