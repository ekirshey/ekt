####![[GENERATE_WARNING]]####
cmake_minimum_required(VERSION 3.28)
project(snake)

set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

add_subdirectory(ekir ${CMAKE_BINARY_DIR}/_deps/ekir)

set(APP_SOURCE
![[INTERNAL_SOURCE_FILES]]
)

add_executable(snake ${APP_SOURCE})

target_include_directories(snake PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}/src
)

source_group(TREE ${CMAKE_CURRENT_SOURCE_DIR} FILES ${APP_SOURCE})

target_link_libraries(snake PRIVATE ekir)

target_compile_options(snake PRIVATE
        $<$<CXX_COMPILER_ID:MSVC>:/W4>
        $<$<CXX_COMPILER_ID:Clang>:-fcolor-diagnostics> # clang color options 
        $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wall -Wextra -Wpedantic>
)

if(APPLE)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} --config-system-dir=/opt/homebrew/etc/clang")
endif()

# Create symlinks
set(ASSETS_SOURCE_DIR ${CMAKE_SOURCE_DIR}/assets)
set(ASSETS_DEST_DIR ${CMAKE_BINARY_DIR}/assets)

set(SCRIPTS_SOURCE_DIR ${CMAKE_SOURCE_DIR}/scripts)
set(SCRIPTS_DEST_DIR ${CMAKE_BINARY_DIR}/scripts)

ADD_CUSTOM_TARGET(copy_assets ALL
        COMMAND ${CMAKE_COMMAND} -E create_symlink ${ASSETS_SOURCE_DIR} ${ASSETS_DEST_DIR})
ADD_CUSTOM_TARGET(copy_scripts ALL
        COMMAND ${CMAKE_COMMAND} -E create_symlink ${SCRIPTS_SOURCE_DIR} ${SCRIPTS_DEST_DIR})

set_target_properties(copy_assets PROPERTIES FOLDER "custom_targets/")
set_target_properties(copy_scripts PROPERTIES FOLDER "custom_targets/")

add_dependencies(snake copy_assets copy_scripts)

# Show assets
file(GLOB_RECURSE ASSET_FILES CONFIGURE_DEPENDS
    ${CMAKE_SOURCE_DIR}/assets/*
)

add_custom_target(assets SOURCES ${ASSET_FILES})

source_group(TREE ${CMAKE_SOURCE_DIR}/assets FILES ${ASSET_FILES})
